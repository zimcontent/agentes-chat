[data-ogsc] .ln-m{color:#999999!important;text-decoration-color:#262626!important}[data-ogsb] .ln-m{color:#999999!important;text-decoration-color:#262626!important}
[data-ogsc] .end-btn{margin-bottom:4px!important}[data-ogsb] .end-btn{margin-bottom:4px!important}
