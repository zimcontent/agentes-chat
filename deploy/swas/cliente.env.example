# .env de um cliente do DougBot. O doug-cliente copia este modelo para
# /opt/doug-clientes/<codigo>-<slug>/.env, preenche o que é do cliente (código, endereço,
# porta, segredos aleatórios) e deixa o arquivo do root e legível só por ele (chmod 600). Uma
# variável nova neste modelo chega aos clientes com `doug-cliente compose <codigo>`, que acrescenta
# o que falta ao .env sem mexer no que existe.
#
# Só entram variáveis que o servidor lê (packages/config/src/schema.ts, com a descrição de
# cada uma em /.env.example na raiz), mais as do DougBot: DOUG_CLIENT_CODE e DOUG_IMAGE, e as
# do compose deste modelo (seção do fim), que o servidor não lê.

# ── DougBot ─────────────────────────────────────────────────────

# Código do cliente (3 dígitos). Prende as customizações dele.
DOUG_CLIENT_CODE=__CODIGO__

# Imagem do servidor. A atualização troca esta linha (doug-atualizar-clientes).
DOUG_IMAGE=__IMAGEM__

# ── Servidor ────────────────────────────────────────────────────

NODE_ENV=production

# O endereço exato que as pessoas abrem, com https e sem barra no fim.
PUBLIC_URL=__PUBLIC_URL__

# O Caddy do host fala com o servidor por uma rede do Docker: o IP real de quem chega vem do
# X-Forwarded-For dele.
# A porta do cliente é publicada no loopback pelo Docker, então o servidor enxerga o proxy com o
# IP do gateway da rede do cliente: as faixas abaixo são as do pool de sub-redes do Docker (o
# padrão, 172.16.0.0/12, e o que o README manda configurar, 10.64.0.0/10).
TRUSTED_PROXIES=127.0.0.1/32,172.16.0.0/12,10.64.0.0/10

# Mantém as conexões abertas por 5 s ao reiniciar, para o Caddy segurar os pedidos.
SHUTDOWN_DELAY_MS=5000

# ── Segurança ───────────────────────────────────────────────────

# Segredo mestre: assina as sessões e cifra as chaves dos modelos que o cliente guarda.
# Trocar torna ilegíveis as chaves guardadas. Entra no backup.
AGENTES_SECRET=__AGENTES_SECRET__

# ── Entrada ─────────────────────────────────────────────────────

# Só o dono entra primeiro: o cadastro fica fechado e a primeira conta é criada só pelo link
# <PUBLIC_URL>/owner#claim=<token>. Aqui fica o SHA-256 do token; o token em si o doug-cliente
# mostra uma vez ao criar o cliente.
ALLOW_SIGNUP=false
OWNER_CLAIM_SHA256=__OWNER_CLAIM_SHA256__

# Endereços privados: FECHADOS. Sem esta linha o servidor os libera (com ALLOW_SIGNUP=false e fora
# da agentes.chat Cloud), e o cliente alcançaria serviços desta máquina e o endpoint de metadados
# do provedor pelos conectores, pelo endpoint de modelo próprio e pelas páginas que os agentes
# leem. Só ponha true num cliente que precisa de um modelo local; README: "Endpoint de modelo
# privado de um cliente".
MODEL_ENDPOINTS_PRIVATE=false

# ── Opcionais (descomente e preencha) ───────────────────────────

# E-mails do cliente (convites, avisos):
# SMTP_URL=
# EMAIL_FROM=

# Backup do banco para o Google Drive do cliente:
# BACKUP_GOOGLE_DRIVE_FOLDER_ID=
# BACKUP_GOOGLE_DRIVE_CLIENT_ID=
# BACKUP_GOOGLE_DRIVE_CLIENT_SECRET=
# BACKUP_GOOGLE_DRIVE_REFRESH_TOKEN=

# ── Do compose (o servidor não lê estas) ────────────────────────

# Senha do Postgres do cliente. O compose a usa nele e na DATABASE_URL do servidor.
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__

# Porta do servidor no loopback do host, escolhida pelo doug-cliente. O Caddy aponta para ela.
DOUG_HOST_PORT=__PORTA__

# Limites do cliente (os do compose valem se ficarem comentados):
# DOUG_MEMORY=3g
# DOUG_CPUS=2
# DOUG_PG_MEMORY=1g
# DOUG_PG_CPUS=1
