[data-ogsc] .avp{background:#1a1a1a!important;color:#ededed!important;border-color:#262626!important}[data-ogsb] .avp{background:#1a1a1a!important;color:#ededed!important;border-color:#262626!important}
[data-ogsc] .warn{background:#2e2410!important}[data-ogsb] .warn{background:#2e2410!important}
[data-ogsc] .warn-t{color:#f5b544!important}[data-ogsb] .warn-t{color:#f5b544!important}
