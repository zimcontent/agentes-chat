</body>
</html>"
`;

exports[`every email, in both languages support_request-lines.pt-BR: snapshot 1`] = `
"<!doctype html>
<html lang="pt-BR" dir="ltr" xmlns="http://www.w3.org/1999/xhtml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
<meta charset="utf-8">
