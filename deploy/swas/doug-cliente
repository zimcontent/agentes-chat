#!/usr/bin/env bash
# doug-cliente: sobe, lista, para, inicia e remove os clientes do DougBot numa máquina
# (uma stack Docker isolada por cliente, atrás de um Caddy só). Passo a passo: deploy/swas/README.md.
#
#   doug-cliente novo <codigo> <slug> "<nome>" [--imagem <tag>]
#   doug-cliente lista
#   doug-cliente parar <codigo>
#   doug-cliente iniciar <codigo>
#   doug-cliente backup <codigo>
#   doug-cliente compose <codigo>
#   doug-cliente remover <codigo> [--apagar-dados] [--sim]
#   doug-cliente cota [<codigo>]
#   doug-cliente religar-proxy
#   doug-cliente limpar-backups <codigo> --antes <AAAA-MM-DD> [--sim]
#
# `--dry-run` (em qualquer comando) mostra o que seria feito sem escrever nada nem rodar o Docker.
#
# Ambiente. O que for fixo da máquina vai em <raiz>/doug-cliente.conf (com sudo o ambiente é
# limpo): um arquivo de root com linhas NOME=valor, lido sem `source` e só para as chaves desta
# lista, que vale mais que o ambiente. DOUG_CLIENTES_DIR só vale no ambiente (a conf fica dentro
# dele; na conf é ignorado, com aviso).
#   DOUG_CLIENTES_DIR        raiz dos clientes (padrão /opt/doug-clientes; só no ambiente)
#   DOUG_CADDY_DIR           pasta do Caddy (padrão: caddy/ ao lado deste script)
#   DOUG_DOMINIO             domínio dos clientes (padrão dougbot.app)
#   DOUG_PROXY_MODE          externo (padrão): o proxy que já existe na máquina, num contêiner, importa
#                            os arquivos da pasta dos sites e fala com cada cliente pela rede dele;
#                            proprio: o Caddy de deploy/swas/caddy, numa máquina dedicada
#   DOUG_PROXY_CONTAINER     (externo) nome do contêiner do proxy: ele é ligado à rede de cada cliente
#   DOUG_PROXY_SITES_DIR     (externo) a pasta dos sites no host, a que o contêiner do proxy monta
#                            (padrão: <DOUG_CADDY_DIR>/clientes)
#   DOUG_PROXY_RELOAD        (externo) comando que recarrega o proxy, por exemplo
#                            docker exec <contêiner> caddy reload --config /etc/caddy/Caddyfile
#   DOUG_IMAGE_REPO          repositório da imagem (padrão agentes-zim)
#   DOUG_CLIENT_QUOTA_GB     cota de disco por cliente, em GB (padrão 40)
#   DOUG_PORTA_INICIAL       primeira porta de loopback a tentar (padrão 3100)
#   DOUG_PORTA_FINAL         última porta (padrão 3999)
#   DOUG_HEALTH_TIMEOUT      segundos de espera pelo /api/health (padrão 240)
#   DOUG_TRAVA_ESPERA        segundos de espera pela trava <raiz>/.lock (padrão 120)
# E, só no ambiente: DOUG_IMAGE, a imagem de `novo` (senão: a mais nova agentes-zim:doug-* desta máquina).
#
# Cada cliente tem o uid 100000 + o código (DOUG_UID no .env), dono de dados/files, e a rede
# 10.64.<código>.0/24 (DOUG_REDE): por isso o código vai de 000 a 255.
#
# Contrato com doug-atualizar-clientes: pasta <raiz>/<codigo>-<slug>/ (root, 711) com compose.yml e
# .env (root, sem escrita para grupo nem outros) e dados/; registro em <raiz>/clientes.tsv (codigo
# slug nome porta imagem criado_em, sem cabeçalho, 600); projeto do Compose doug-<codigo>; serviços
# `agentes` e `postgres`; DOUG_IMAGE no .env; trava única <raiz>/.lock (600, flock obrigatório);
# backups em <raiz>/backups/<codigo>/ (root, 700), fora de dados/.
set -euo pipefail

shopt -u patsub_replacement 2>/dev/null || true

SCRIPT=$(readlink -f "${BASH_SOURCE[0]}")
SWAS_DIR=$(dirname "$SCRIPT")
RAIZ=${DOUG_CLIENTES_DIR:-/opt/doug-clientes}
REGISTRO=$RAIZ/clientes.tsv

# O que é fixo da máquina (modo do proxy, comando de recarga) vem de um arquivo de root: o sudo
# limpa o ambiente, e um comando lido do ambiente de quem chama rodaria como root. O arquivo não
# é executado: cada linha é NOME=valor, só de uma chave conhecida, e o valor vale como texto.
CONF=$RAIZ/doug-cliente.conf
CONF_CHAVES=" DOUG_CADDY_DIR DOUG_DOMINIO DOUG_PROXY_MODE DOUG_PROXY_CONTAINER DOUG_PROXY_SITES_DIR DOUG_PROXY_RELOAD DOUG_IMAGE_REPO DOUG_CLIENT_QUOTA_GB DOUG_PORTA_INICIAL DOUG_PORTA_FINAL DOUG_HEALTH_TIMEOUT DOUG_TRAVA_ESPERA "
declare -A CONF_VALORES=()

le_conf() {
  local dono modo linha chave valor n=0
  dono=$(stat -c %u "$CONF")
  modo=$(stat -c %a "$CONF")
  if [[ $dono != "$EUID" ]] || ((8#$modo & 8#022)); then
    printf 'doug-cliente: %s tem de ser do usuário que roda o script e sem escrita para grupo nem outros\n' "$CONF" >&2
    exit 1
  fi
  while IFS= read -r linha || [[ -n $linha ]]; do
    n=$((n + 1))
    linha=${linha#"${linha%%[![:space:]]*}"}
    linha=${linha%"${linha##*[![:space:]]}"}
    [[ -z $linha || $linha == \#* ]] && continue
    if [[ ! $linha =~ ^([A-Z][A-Z0-9_]*)=(.*)$ ]]; then
      printf 'doug-cliente: %s, linha %d: só vale NOME=valor\n' "$CONF" "$n" >&2
      exit 1
    fi
    chave=${BASH_REMATCH[1]}
    valor=${BASH_REMATCH[2]}
    if [[ $valor == \"*\" && ${#valor} -ge 2 ]] || [[ $valor == \'*\' && ${#valor} -ge 2 ]]; then
      valor=${valor:1:${#valor}-2}
    fi
    if [[ $CONF_CHAVES != *" $chave "* ]]; then
      printf 'aviso: %s, linha %d: %s não vale na conf (ignorada)\n' "$CONF" "$n" "$chave" >&2
      continue
    fi
    CONF_VALORES[$chave]=$valor
  done <"$CONF"
}
[[ ! -e $CONF ]] || le_conf

# valor <NOME> <padrão>: a conf manda, depois o ambiente, depois o padrão.
valor() {
  if [[ -v CONF_VALORES[$1] ]]; then
    printf '%s' "${CONF_VALORES[$1]}"
  elif [[ -n ${!1:-} ]]; then
    printf '%s' "${!1}"
  else
    printf '%s' "$2"
  fi
}

CADDY_DIR=$(valor DOUG_CADDY_DIR "$SWAS_DIR/caddy")
DOMINIO=$(valor DOUG_DOMINIO dougbot.app)
COTA_GB=$(valor DOUG_CLIENT_QUOTA_GB 40)
PORTA_INICIAL=$(valor DOUG_PORTA_INICIAL 3100)
PORTA_FINAL=$(valor DOUG_PORTA_FINAL 3999)
SAUDE_S=$(valor DOUG_HEALTH_TIMEOUT 240)
PROXY_MODE=$(valor DOUG_PROXY_MODE externo)
PROXY_RELOAD=$(valor DOUG_PROXY_RELOAD "")
PROXY_CONTAINER=$(valor DOUG_PROXY_CONTAINER "")
SITES_DIR=$(valor DOUG_PROXY_SITES_DIR "$CADDY_DIR/clientes")
TRAVA_S=$(valor DOUG_TRAVA_ESPERA 120)
CADDY_ADMIN=unix//run/caddy-admin/admin.sock
REPO_IMAGEM=$(valor DOUG_IMAGE_REPO agentes-zim)

# Estes valores entram em contas e em comandos: só número.
for v in COTA_GB PORTA_INICIAL PORTA_FINAL SAUDE_S TRAVA_S; do
  [[ ${!v} =~ ^[0-9]+([.][0-9]+)?$ ]] || {
    printf 'doug-cliente: o valor de %s não é um número: "%s"\n' "$v" "${!v}" >&2
    exit 1
  }
done
[[ $PORTA_INICIAL =~ ^[0-9]+$ && $PORTA_FINAL =~ ^[0-9]+$ && $SAUDE_S =~ ^[0-9]+$ && $TRAVA_S =~ ^[0-9]+$ ]] || {
  printf 'doug-cliente: portas, tempos e a espera da trava são números inteiros\n' >&2
  exit 1
}

AJUDA=0
DRY=0
SIM=0
APAGAR=0
IMAGEM=${DOUG_IMAGE:-}
PEDIU_IMAGEM=0
ANTES=""
POSICIONAIS=()

diz() { printf '%s\n' "$*"; }
passo() { printf '→ %s\n' "$*"; }
aviso() { printf 'aviso: %s\n' "$*" >&2; }
erro() {
  printf 'doug-cliente: %s\n' "$*" >&2
  exit 1
}
simula() { printf '[simulação] %s\n' "$*"; }

uso() {
  sed -n '2,/^set -euo/p' "$SCRIPT" | sed '$d' | sed 's/^# \{0,1\}//'
}

# ─── argumentos ──────────────────────────────────────────────────────────────

ler_argumentos() {
  while (($#)); do
    case $1 in
      --dry-run) DRY=1 ;;
      --sim) SIM=1 ;;
      --apagar-dados) APAGAR=1 ;;
      --imagem)
        (($# >= 2)) || erro "--imagem pede o nome da imagem"
        [[ $2 != -* ]] || erro "--imagem $2: um nome de imagem não começa com hífen"
        IMAGEM=$2
        PEDIU_IMAGEM=1
        shift
        ;;
      --imagem=*)
        IMAGEM=${1#--imagem=}
        [[ $IMAGEM != -* ]] || erro "--imagem $IMAGEM: um nome de imagem não começa com hífen"
        PEDIU_IMAGEM=1
        ;;
      --antes)
        (($# >= 2)) || erro "--antes pede uma data (AAAA-MM-DD)"
        ANTES=$2
        shift
        ;;
      --antes=*) ANTES=${1#--antes=} ;;
      -h | --ajuda | --help) AJUDA=1 ;;
      -*) erro "opção desconhecida: $1 (veja doug-cliente --ajuda)" ;;
      *) POSICIONAIS+=("$1") ;;
    esac
    shift
  done
}

# ─── validação ───────────────────────────────────────────────────────────────

RESERVADOS=" www app api admin mail caddy doug dougbot status suporte painel "

# O código vira o uid (100000 + código) e a rede (10.64.<código>.0/24) do cliente: a rede só tem
# um terceiro número de 0 a 255, e por isso o código acaba em 255.
valida_codigo() {
  [[ $1 =~ ^[0-9]{3}$ ]] || erro "código inválido: \"$1\" (são 3 dígitos, como 064)"
  ((10#$1 <= 255)) || erro "código inválido: \"$1\" (a rede do cliente é 10.64.<código>.0/24: o código vai de 000 a 255)"
}

uid_do_cliente() { printf '%s' "$((100000 + 10#$1))"; }
rede_do_cliente() { printf '10.64.%s' "$((10#$1))"; }

valida_imagem() {
  [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9._:/@-]*$ ]] || erro "nome de imagem inválido: \"$1\" (letras, números e . _ : / @ -, sem começar com hífen)"
}

valida_slug() {
  [[ $1 =~ ^[a-z0-9]([a-z0-9-]{0,38}[a-z0-9])?$ ]] \
    || erro "slug inválido: \"$1\" (letras minúsculas, números e hífen, de 1 a 40 caracteres, sem hífen nas pontas)"
  [[ $RESERVADOS != *" $1 "* ]] || erro "o slug \"$1\" é reservado"
}

valida_nome() {
  [[ -n $1 ]] || erro "o nome do cliente não pode ser vazio"
  ((${#1} <= 80)) || erro "o nome do cliente passa de 80 caracteres"
  [[ $1 != *[[:cntrl:]]* ]] || erro "o nome do cliente não pode ter tabulação nem quebra de linha"
}

# ─── registro (clientes.tsv) ─────────────────────────────────────────────────

# Todo texto do registro é comparado como texto (`"" `): o awk compara como número o que parece um
# número, e 064 seria igual a 64.
registro_tem() { # <coluna> <valor>
  [[ -f $REGISTRO ]] || return 1
  awk -F'\t' -v col="$1" -v val="$2" '$col "" == val "" { achou = 1 } END { exit !achou }' "$REGISTRO"
}

registro_linha() { # <codigo>
  [[ -f $REGISTRO ]] || return 0
  awk -F'\t' -v val="$1" '$1 "" == val "" { print; exit }' "$REGISTRO"
}

registro_acrescenta() { # codigo slug nome porta imagem
  local agora
  agora=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  # O registro tem os nomes dos clientes: só o root o lê (o doug-atualizar-clientes e este script
  # rodam como root).
  (umask 077 && printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$4" "$5" "$agora" >>"$REGISTRO")
  chmod 600 "$REGISTRO"
}

registro_tira() { # <codigo>
  local tmp
  tmp=$(mktemp "$RAIZ/.clientes.XXXXXX")
  awk -F'\t' -v val="$1" '$1 "" != val ""' "$REGISTRO" >"$tmp"
  chmod 600 "$tmp"
  mv "$tmp" "$REGISTRO"
}

# Lê um cliente do registro em CODIGO, SLUG, NOME, PORTA, IMAGEM_REG, CRIADO e PASTA. O que vem do
# arquivo é conferido de novo: ele vira nome de pasta e linha de configuração do proxy.
carrega_cliente() { # <codigo>
  local linha
  valida_codigo "$1"
  linha=$(registro_linha "$1")
  [[ -n $linha ]] || erro "o cliente $1 não está em $REGISTRO (veja: doug-cliente lista)"
  IFS=$'\t' read -r CODIGO SLUG NOME PORTA IMAGEM_REG CRIADO <<<"$linha"
  valida_slug "$SLUG"
  [[ $PORTA =~ ^[0-9]+$ ]] || erro "a linha do cliente $1 em $REGISTRO tem uma porta inválida: \"$PORTA\""
  PASTA=$RAIZ/$CODIGO-$SLUG
}

env_valor() { # <arquivo> <variável>
  [[ -f $1 ]] || return 0
  awk -v k="$2" 'index($0, k "=") == 1 { print substr($0, length(k) + 2); exit }' "$1"
}

# ─── trava ───────────────────────────────────────────────────────────────────

# A trava é uma só, a mesma do doug-atualizar-clientes: <raiz>/.lock. Sem flock não há trava, e
# sem trava dois scripts escrevem no mesmo clientes.tsv e escolhem a mesma porta.
trava() {
  command -v flock >/dev/null 2>&1 || erro "falta o comando flock (util-linux): sem ele não há trava contra outro doug-cliente nem contra o doug-atualizar-clientes"
  mkdir -p "$RAIZ"
  # Ninguém além do root lista a raiz (quem não é root não descobre os clientes); passar por ela
  # até uma pasta de cliente é permitido, e cada pasta tem o seu próprio modo.
  chmod 711 "$RAIZ"
  # 600: quem não é root não abre o arquivo e não consegue travar o instalador. Criado antes (e
  # nunca recriado: um flock vale por arquivo) e com o modo refeito a cada vez.
  [[ -e $RAIZ/.lock ]] || (umask 077 && : >"$RAIZ/.lock")
  chmod 600 "$RAIZ/.lock"
  exec 9>"$RAIZ/.lock"
  flock -w "$TRAVA_S" 9 || erro "outro doug-cliente ou o doug-atualizar-clientes está rodando (trava em $RAIZ/.lock; esperei ${TRAVA_S}s)"
}

# ─── Docker, proxy ───────────────────────────────────────────────────────────

# O docker e tudo o que roda daqui (o recarregamento do proxy também) sai sem o descritor 9, o da
# trava: um filho que ficasse vivo com ele segurava a trava depois de este script terminar.
dk() { command docker "$@" 9>&-; }

tem_docker() { command -v docker >/dev/null 2>&1; }

exige_docker() {
  if ! tem_docker; then
    ((DRY)) && return 0
    erro "o Docker não está instalado (README: pré-requisitos)"
  fi
  dk compose version >/dev/null 2>&1 || {
    ((DRY)) && return 0
    erro "falta o plugin Compose v2 do Docker (docker compose)"
  }
}

exige_comando() {
  command -v "$1" >/dev/null 2>&1 || erro "falta o comando $1 nesta máquina"
}

compose() { # <codigo> <pasta> <argumentos do compose...>
  local codigo=$1 pasta=$2
  shift 2
  dk compose -p "doug-$codigo" --project-directory "$pasta" -f "$pasta/compose.yml" --env-file "$pasta/.env" "$@"
}

compose_caddy() {
  dk compose -f "$CADDY_DIR/compose.yml" "$@"
}

caddy_arquivo() { printf '%s/%s.caddy' "$SITES_DIR" "$1"; }

# O endereço do servidor do cliente para o proxy. No modo externo o proxy é um contêiner na rede do
# cliente (a rede doug-<codigo>) e fala com o contêiner do servidor pelo nome; no modo próprio o
# Caddy está na rede do host e usa a porta de loopback.
upstream_de() { # codigo porta
  if [[ $PROXY_MODE == externo ]]; then
    printf 'doug-%s-agentes-1:3000' "$1"
  else
    printf '127.0.0.1:%s' "$2"
  fi
}

caddy_texto() { # codigo slug porta
  cat <<EOT
# doug-cliente: $1 $2 (escrito por doug-cliente; não edite à mão)
$2.$DOMINIO {
	request_body /mcp* {
		max_size 128KiB
	}
	reverse_proxy $(upstream_de "$1" "$3")
	handle_errors 502 503 504 {
		header Cache-Control no-store
		header Content-Type "text/plain; charset=utf-8"
		respond "O DougBot já volta: o servidor não está respondendo agora. Tente de novo em instantes." 503
	}
}
EOT
}

valida_modo_proxy() {
  case $PROXY_MODE in
    externo)
      [[ $PROXY_CONTAINER =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] \
        || erro "DOUG_PROXY_CONTAINER (o nome do contêiner do proxy que já existe) não está definido ou é inválido: ponha em $CONF (README: O proxy)"
      ;;
    proprio) ;;
    *) erro "DOUG_PROXY_MODE=$PROXY_MODE não existe (use externo ou proprio)" ;;
  esac
}

# O contêiner do proxy já está na rede deste cliente?
proxy_na_rede() { # <codigo>
  local membros
  membros=$(dk network inspect -f '{{range .Containers}}{{.Name}} {{end}}' "doug-$1" 2>/dev/null | tr '\n' ' ') || return 1
  [[ " $membros" == *" $PROXY_CONTAINER "* ]]
}

# Modo externo: liga o proxy à rede do cliente, com o endereço .2 dela (o servidor só confia nesse
# endereço, na sub-rede do cliente: TRUSTED_PROXIES).
proxy_liga() { # <codigo>
  [[ $PROXY_MODE == externo ]] || return 0
  proxy_na_rede "$1" && return 0
  dk network connect --ip "$(rede_do_cliente "$1").2" "doug-$1" "$PROXY_CONTAINER" \
    || erro "não consegui ligar o contêiner $PROXY_CONTAINER à rede doug-$1 (confira o nome em DOUG_PROXY_CONTAINER: docker ps)"
}

# O compose do cliente só derruba a rede sem ninguém ligado a ela.
proxy_desliga() { # <codigo>
  [[ $PROXY_MODE == externo ]] || return 0
  proxy_na_rede "$1" || return 0
  dk network disconnect "doug-$1" "$PROXY_CONTAINER" \
    || erro "não consegui desligar o contêiner $PROXY_CONTAINER da rede doug-$1: nada foi derrubado"
}

# Faz o proxy ler os arquivos da pasta dos sites de novo.
#  - proprio: sobe o Caddy de deploy/swas/caddy se preciso e recarrega pelo socket de admin, que
#    é Unix num volume só de root (nada de porta de administração no host).
#  - externo: o proxy que já existe na máquina (um contêiner) importa os arquivos da pasta; quem
#    recarrega é o comando de DOUG_PROXY_RELOAD.
caddy_recarrega() {
  if [[ $PROXY_MODE == proprio ]]; then
    compose_caddy up -d >/dev/null || return 1
    compose_caddy exec -T caddy caddy reload --config /etc/caddy/Caddyfile --address "$CADDY_ADMIN" --force >/dev/null
    return
  fi
  if [[ -z $PROXY_RELOAD ]]; then
    aviso "DOUG_PROXY_RELOAD não está definido: recarregue o proxy à mão para ele ler $SITES_DIR (README: O proxy)"
    return 0
  fi
  bash -c "$PROXY_RELOAD" >/dev/null 9>&-
}

caddy_escreve() { # codigo slug porta
  local arquivo existia=0 antigo=""
  arquivo=$(caddy_arquivo "$2")
  if [[ -e $arquivo ]]; then
    grep -q "^# doug-cliente: $1 " "$arquivo" || erro "$arquivo já existe e não é do cliente $1"
    existia=1
    antigo=$(cat "$arquivo")
  fi
  # O proxy (um contêiner) lê esta pasta: ela e os arquivos ficam legíveis, só o root escreve.
  mkdir -p "$SITES_DIR"
  chmod 755 "$SITES_DIR"
  caddy_texto "$1" "$2" "$3" >"$arquivo"
  chmod 644 "$arquivo"
  if ! caddy_recarrega; then
    if ((existia)); then printf '%s\n' "$antigo" >"$arquivo"; else rm -f "$arquivo"; fi
    erro "o proxy não aceitou o endereço de $2 (voltei o arquivo ao que era; o cliente fica sem registro, rode o mesmo comando de novo). Veja o log do proxy ($PROXY_MODE)"
  fi
}

caddy_tira() { # <slug>
  local arquivo
  arquivo=$(caddy_arquivo "$1")
  [[ -e $arquivo ]] || return 0
  rm -f "$arquivo"
  caddy_recarrega || aviso "tirei $arquivo, mas o proxy não recarregou; recarregue à mão (README)"
}

# As portas que já têm dono: as do registro e as de todo .env de pasta de cliente, mesmo o do
# cliente que foi começado e ainda não foi registrado (caiu antes do fim).
portas_tomadas() { # [<pasta a ignorar>]
  local env p out=" "
  if [[ -f $REGISTRO ]]; then
    out+=$(awk -F'\t' '{ printf "%s ", $4 }' "$REGISTRO")
  fi
  for env in "$RAIZ"/*/.env; do
    [[ -f $env ]] || continue
    [[ -n ${1:-} && $env == "$1/.env" ]] && continue
    p=$(env_valor "$env" DOUG_HOST_PORT)
    [[ -z $p ]] || out+="$p "
  done
  printf '%s' "$out"
}

porta_ocupada() { # <porta>: algo já escuta nela neste host
  (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null
}

porta_livre() { # [<pasta a ignorar>]
  local porta tomadas
  tomadas=$(portas_tomadas "${1:-}")
  for ((porta = PORTA_INICIAL; porta <= PORTA_FINAL; porta++)); do
    [[ $tomadas == *" $porta "* ]] && continue
    porta_ocupada "$porta" && continue
    printf '%s' "$porta"
    return 0
  done
  return 1
}

esperar_saude() { # <porta>
  local porta=$1 limite=$((SECONDS + SAUDE_S))
  while ((SECONDS < limite)); do
    if curl -fsS --max-time 5 "http://127.0.0.1:$porta/api/health" >/dev/null 2>&1 9>&-; then
      return 0
    fi
    sleep "${DOUG_HEALTH_INTERVALO:-3}"
  done
  return 1
}

# Espera o Postgres do cliente aceitar conexões (usado antes de um backup).
esperar_banco() { # <codigo> <pasta>
  local limite=$((SECONDS + 90))
  while ((SECONDS < limite)); do
    if compose "$1" "$2" exec -T postgres pg_isready -h 127.0.0.1 -U agentes -d agentes >/dev/null 2>&1; then
      return 0
    fi
    sleep "${DOUG_HEALTH_INTERVALO:-3}"
  done
  return 1
}

# ─── disco ───────────────────────────────────────────────────────────────────

livre_kb() { # espaço livre onde a raiz fica (ou no primeiro diretório que existir acima dela)
  local dir=$RAIZ
  while [[ ! -d $dir && $dir != / ]]; do dir=$(dirname "$dir"); done
  df -Pk "$dir" | awk 'NR == 2 { print $4 }'
}

# Falha (e não inventa um número) se não conseguir medir: sem root o Postgres não é legível.
usado_kb() { # <pasta do cliente>
  local kb
  [[ -d $1/dados ]] || {
    printf 0
    return
  }
  kb=$(du -sk "$1/dados" 2>/dev/null | awk '{ print $1 }') || return 1
  [[ $kb =~ ^[0-9]+$ ]] || return 1
  printf '%s' "$kb"
}

cota_kb() { awk -v c="$COTA_GB" 'BEGIN { printf "%.0f", c * 1048576 }'; }

# Os clientes que têm espaço prometido: os do registro e as pastas de clientes começados e ainda
# não registrados (caíram antes do fim; o `novo` os continua), menos a pasta ignorada. Uma pasta
# por linha.
pastas_de_clientes() { # [<pasta a ignorar>]
  local codigo slug resto d
  declare -A vistas=()
  if [[ -s $REGISTRO ]]; then
    while IFS=$'\t' read -r codigo slug resto || [[ -n ${codigo:-} ]]; do
      [[ -z ${codigo:-} || $codigo == \#* ]] && continue
      d=$RAIZ/$codigo-$slug
      [[ $d == "${1:-}" || -n ${vistas[$d]:-} ]] && continue
      vistas[$d]=1
      printf '%s\n' "$d"
    done <"$REGISTRO"
  fi
  for d in "$RAIZ"/[0-9][0-9][0-9]-*/; do
    d=${d%/}
    [[ -d $d && $d != "${1:-}" && -z ${vistas[$d]:-} ]] || continue
    vistas[$d]=1
    printf '%s\n' "$d"
  done
}

# Mede o disco de cada cliente. É devagar (um du por cliente) e roda ANTES da trava, para ela não
# ficar presa nisso; depois da trava só se mede o que apareceu nesse meio-tempo.
declare -A USADO_KB=()
mede_clientes() { # [<pasta a ignorar>]
  local d kb
  while IFS= read -r d; do
    [[ -n $d ]] || continue
    kb=$(usado_kb "$d") || erro "não consegui medir $d/dados (rode como root)"
    USADO_KB[$d]=$kb
  done < <(pastas_de_clientes "${1:-}")
}

# Cabe a cota deste cliente, além do que os clientes de hoje ainda podem usar da cota deles? O
# espaço prometido é o de todos: a soma do que falta a cada um para chegar na sua cota, inclusive
# o dos clientes começados e ainda não registrados.
confere_disco() { # <pasta do cliente novo>
  local livre cota reservado=0 kb d n=0 nova
  cota=$(cota_kb)
  livre=$(livre_kb)
  while IFS= read -r d; do
    [[ -n $d ]] || continue
    kb=${USADO_KB[$d]:-}
    [[ -n $kb ]] || kb=$(usado_kb "$d") || erro "não consegui medir $d/dados (rode como root)"
    n=$((n + 1))
    if ((kb < cota)); then reservado=$((reservado + cota - kb)); fi
  done < <(pastas_de_clientes "$1")
  kb=$(usado_kb "$1") || erro "não consegui medir $1/dados (rode como root)"
  nova=0
  if ((kb < cota)); then nova=$((cota - kb)); fi
  if ((livre < reservado + nova)); then
    erro "falta disco: restam $((livre / 1048576)) GB livres; os $n clientes de hoje ainda podem usar $((reservado / 1048576)) GB da cota deles e o novo pede $((nova / 1048576)) GB (cota de ${COTA_GB} GB por cliente, DOUG_CLIENT_QUOTA_GB)"
  fi
}

# ─── permissões ──────────────────────────────────────────────────────────────

# Só o root lê a pasta de um cliente por dentro: a pasta e dados/ deixam passar (711) para o
# Postgres da imagem, que entra por dados/postgres (o PGDATA dele é 700 do usuário postgres), e
# dados/files é só do uid do cliente (100000 + o código, DOUG_UID do .env; 700): nem o de um login
# da máquina nem o de outro cliente. A pasta, o compose.yml e o .env são do root e sem escrita para
# grupo nem outros: o doug-atualizar-clientes recusa o cliente que não estiver assim.
ajusta_permissoes() { # <pasta>
  local p=$1 f uid donos=()
  uid=$(env_valor "$p/.env" DOUG_UID)
  [[ $uid =~ ^[0-9]+$ ]] || erro "$p/.env não tem DOUG_UID (doug-cliente compose <codigo> acrescenta)"
  chmod 711 "$p" "$p/dados"
  chmod 700 "$p/dados/files"
  chmod 644 "$p/compose.yml"
  for f in "$p/.env" "$p/link-do-dono.txt"; do
    [[ -f $f ]] && chmod 600 "$f"
  done
  donos=("$p" "$p/dados" "$p/compose.yml" "$p/.env")
  [[ ! -f $p/link-do-dono.txt ]] || donos+=("$p/link-do-dono.txt")
  # Sem root o chown não muda o dono: avisa em vez de parar (em produção este script roda como root).
  if ((EUID == 0)); then
    chown root:root "${donos[@]}" || erro "não consegui dar $p ao root"
    chown "$uid:$uid" "$p/dados/files" || erro "não consegui dar $p/dados/files ao uid $uid"
  else
    chown root:root "${donos[@]}" 2>/dev/null || true
    chown "$uid:$uid" "$p/dados/files" 2>/dev/null \
      || aviso "sem root, não deu para ajustar o dono de dados/files; rode com sudo (README)"
  fi
}

# ─── novo ────────────────────────────────────────────────────────────────────

# Preenche o modelo do .env: __NOME__ vira o valor.
preenche_env() { # <porta> <imagem> <segredo> <senha do banco> <hash do link do dono>
  local texto
  texto=$(cat "$SWAS_DIR/cliente.env.example")
  texto=${texto//__CODIGO__/$CODIGO}
  texto=${texto//__IMAGEM__/$2}
  texto=${texto//__PUBLIC_URL__/https://$SLUG.$DOMINIO}
  texto=${texto//__AGENTES_SECRET__/$3}
  texto=${texto//__POSTGRES_PASSWORD__/$4}
  texto=${texto//__OWNER_CLAIM_SHA256__/$5}
  texto=${texto//__PORTA__/$1}
  texto=${texto//__UID__/$(uid_do_cliente "$CODIGO")}
  texto=${texto//__REDE__/$(rede_do_cliente "$CODIGO")}
  [[ $texto != *__*__* ]] || erro "o modelo cliente.env.example tem um campo que o instalador não preenche"
  printf '%s\n' "$texto"
}

segredo() { # base64|hex
  local s
  case $1 in
    base64) s=$(openssl rand -base64 48 | tr -d '\n') ;;
    hex) s=$(openssl rand -hex 24 | tr -d '\n') ;;
  esac || erro "o openssl não gerou o segredo (confira: openssl rand -hex 24)"
  [[ -n $s ]] || erro "o openssl não gerou o segredo"
  printf '%s' "$s"
}

imagem_padrao() {
  tem_docker || return 0
  dk images --format '{{.Repository}}:{{.Tag}}' "$REPO_IMAGEM" 2>/dev/null | grep -m1 ":doug-" || true
}

limpa_env_novo() { [[ -z ${PASTA:-} ]] || rm -f "$PASTA/.env.novo"; }

cmd_novo() {
  ((${#POSICIONAIS[@]} == 3)) || erro 'uso: doug-cliente novo <codigo> <slug> "<nome>"'
  CODIGO=${POSICIONAIS[0]} SLUG=${POSICIONAIS[1]} NOME=${POSICIONAIS[2]}
  valida_codigo "$CODIGO"
  valida_slug "$SLUG"
  valida_nome "$NOME"
  valida_modo_proxy
  if ((!DRY)); then
    exige_comando openssl
    exige_comando curl
    exige_comando sha256sum
    exige_comando tar
  fi
  exige_docker

  local pasta=$RAIZ/$CODIGO-$SLUG
  PASTA=$pasta

  # O que é lento (medir o disco de cada cliente) vem antes da trava; a trava vem antes de tudo o
  # que decide (registro, portas, a conta do disco): quem chega depois espera e já vê o que o
  # primeiro fez.
  mede_clientes "$pasta"
  if ((!DRY)); then
    trava
    trap limpa_env_novo EXIT
  fi

  registro_tem 1 "$CODIGO" && erro "o código $CODIGO já é de outro cliente (veja: doug-cliente lista)"
  registro_tem 2 "$SLUG" && erro "o slug $SLUG já é de outro cliente (veja: doug-cliente lista)"
  local outra
  for outra in "$RAIZ/$CODIGO"-*; do
    [[ -e $outra && $outra != "$pasta" ]] && erro "já existe $outra, de outro slug com o código $CODIGO"
  done
  # O slug de um cliente começado e ainda não registrado também é dele.
  for outra in "$RAIZ"/[0-9][0-9][0-9]-"$SLUG"; do
    [[ -e $outra && $outra != "$pasta" ]] && erro "já existe $outra: o slug $SLUG é de um cliente começado e ainda não registrado (rode o novo dele de novo, ou confira a pasta)"
  done
  local existente=0
  [[ -f $pasta/.env ]] && existente=1
  if ((!existente)) && [[ -d $pasta/dados/postgres ]] && [[ -n $(ls -A "$pasta/dados/postgres" 2>/dev/null) ]]; then
    erro "$pasta/dados/postgres já tem dados e o .env se foi: sem a senha o banco não abre. Confira o que houve antes de seguir"
  fi

  # A imagem: numa pasta já começada vale a do .env; pedir outra aqui é recusado, para o .env e o
  # registro não divergirem (trocar a imagem de um cliente é com o doug-atualizar-clientes).
  if ((existente)); then
    local img_env
    img_env=$(env_valor "$pasta/.env" DOUG_IMAGE)
    [[ -n $img_env ]] || erro "$pasta/.env não tem DOUG_IMAGE"
    if ((PEDIU_IMAGEM)) && [[ $IMAGEM != "$img_env" ]]; then
      erro "o .env de $pasta já usa a imagem $img_env e --imagem $IMAGEM não muda isso. Rode sem --imagem para continuar com a do .env, ou corrija DOUG_IMAGE no .env antes"
    fi
    IMAGEM=$img_env
  else
    [[ -n $IMAGEM ]] || IMAGEM=$(imagem_padrao)
  fi
  [[ -n $IMAGEM ]] || erro "qual imagem? Passe --imagem agentes-zim:doug-<sha> ou DOUG_IMAGE (nenhuma agentes-zim:doug-* nesta máquina)"
  valida_imagem "$IMAGEM"
  if tem_docker && ! dk image inspect "$IMAGEM" >/dev/null 2>&1; then
    erro "a imagem $IMAGEM não existe nesta máquina (docker images $REPO_IMAGEM)"
  fi

  confere_disco "$pasta"

  # A porta: a do .env se o cliente já foi começado (desde que nenhum outro cliente a tenha),
  # senão a primeira que nem o registro nem um .env de outra pasta nem o host usam.
  local porta
  if ((existente)); then
    porta=$(env_valor "$pasta/.env" DOUG_HOST_PORT)
    [[ $porta =~ ^[0-9]+$ ]] || erro "$pasta/.env não tem DOUG_HOST_PORT"
    [[ $(portas_tomadas "$pasta") != *" $porta "* ]] || erro "a porta $porta do .env de $pasta já é de outro cliente"
  else
    porta=$(porta_livre) || erro "nenhuma porta livre entre $PORTA_INICIAL e $PORTA_FINAL"
  fi

  diz "Cliente $CODIGO ($SLUG) — $NOME"
  diz "  endereço: https://$SLUG.$DOMINIO"
  diz "  pasta:    $pasta"
  diz "  porta:    127.0.0.1:$porta (só a saúde confere por ela)"
  diz "  uid:      $(uid_do_cliente "$CODIGO"), rede $(rede_do_cliente "$CODIGO").0/24"
  diz "  imagem:   $IMAGEM"

  if ((DRY)); then
    ((existente)) && simula "a pasta já foi começada: mantenho o .env e os segredos que ela tem"
    simula "criar $pasta/dados/postgres e $pasta/dados/files (700, dono o uid $(uid_do_cliente "$CODIGO")); pasta e dados/ com 711"
    simula "copiar compose.cliente.yml para $pasta/compose.yml (dono root, sem escrita para grupo nem outros)"
    ((existente)) || simula "gerar $pasta/.env (root, chmod 600) com segredos de openssl rand"
    simula "docker compose -p doug-$CODIGO up -d"
    [[ $PROXY_MODE != externo ]] || simula "ligar o contêiner $PROXY_CONTAINER à rede doug-$CODIGO (docker network connect --ip $(rede_do_cliente "$CODIGO").2)"
    simula "esperar http://127.0.0.1:$porta/api/health por até ${SAUDE_S}s"
    simula "escrever $(caddy_arquivo "$SLUG") (upstream $(upstream_de "$CODIGO" "$porta")) e recarregar o proxy (modo $PROXY_MODE)"
    simula "registrar o cliente em $REGISTRO"
    return 0
  fi

  passo "preparando a pasta"
  mkdir -p "$pasta/dados/postgres" "$pasta/dados/files"
  install -m 644 "$SWAS_DIR/compose.cliente.yml" "$pasta/compose.yml"

  local link=$pasta/link-do-dono.txt
  if ((existente)); then
    passo "o .env desta pasta já existe: mantenho os segredos dele"
  else
    local token seg_agentes seg_pg
    token=$(openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\n') || erro "o openssl não gerou o link do dono (confira: openssl rand -base64 32)"
    [[ -n $token ]] || erro "o openssl não gerou o link do dono"
    seg_agentes=$(segredo base64)
    seg_pg=$(segredo hex)
    local claim_hash
    claim_hash=$(printf '%s' "$token" | sha256sum | awk '{ print $1 }')
    rm -f "$pasta/.env.novo"
    umask 077
    preenche_env "$porta" "$IMAGEM" "$seg_agentes" "$seg_pg" "$claim_hash" >"$pasta/.env.novo"
    mv "$pasta/.env.novo" "$pasta/.env"
    printf 'https://%s.%s/owner#claim=%s\n' "$SLUG" "$DOMINIO" "$token" >"$link"
    umask 022
  fi
  ajusta_permissoes "$pasta"

  passo "subindo a stack (docker compose -p doug-$CODIGO up -d)"
  compose "$CODIGO" "$pasta" up -d
  if [[ $PROXY_MODE == externo ]]; then
    passo "ligando $PROXY_CONTAINER à rede doug-$CODIGO"
    proxy_liga "$CODIGO"
  fi

  passo "esperando o /api/health (até ${SAUDE_S}s)"
  esperar_saude "$porta" || erro "o cliente não respondeu em ${SAUDE_S}s. Veja: docker compose -p doug-$CODIGO logs; rodar este mesmo comando de novo continua de onde parou"

  passo "publicando $SLUG.$DOMINIO no proxy ($PROXY_MODE)"
  caddy_escreve "$CODIGO" "$SLUG" "$porta"

  registro_acrescenta "$CODIGO" "$SLUG" "$NOME" "$porta" "$IMAGEM"
  passo "registrado em $REGISTRO"

  diz ""
  diz "Pronto: https://$SLUG.$DOMINIO"
  if [[ -f $link ]]; then
    diz "O primeiro acesso, para a pessoa dona do espaço criar a conta (vale uma vez; fica em $link):"
    diz "  $(cat "$link")"
  fi
}

# ─── compose: reinstala o compose.yml e completa o .env ──────────────────────

# O modelo mudou (uma variável nova, um limite): reinstala o compose.yml e acrescenta ao .env o
# que faltar, sem mexer no que já existe. Não inventa segredo: sem AGENTES_SECRET ou
# POSTGRES_PASSWORD o .env não é deste cliente, e um novo tornaria ilegível o que ele já guardou.
cmd_compose() {
  ((${#POSICIONAIS[@]} == 1)) || erro "uso: doug-cliente compose <codigo>"
  ((DRY)) || trava
  carrega_cliente "${POSICIONAIS[0]}"
  pasta_pronta
  local env=$PASTA/.env agentes pg imagem chave valor linha
  agentes=$(env_valor "$env" AGENTES_SECRET)
  pg=$(env_valor "$env" POSTGRES_PASSWORD)
  imagem=$(env_valor "$env" DOUG_IMAGE)
  [[ -n $imagem ]] || imagem=$IMAGEM_REG
  [[ -n $agentes && -n $pg ]] || erro "o $env não tem AGENTES_SECRET e POSTGRES_PASSWORD: não invento segredos para um cliente que já tem dados. Confira o que houve com o arquivo"

  # O modelo é preenchido numa variável: o erro de um campo sem valor para o comando, em vez de
  # sumir dentro de uma substituição de processo e deixar o .env sem as variáveis novas.
  local modelo
  modelo=$(preenche_env "$PORTA" "$imagem" "$agentes" "$pg" "") \
    || erro "não consegui preencher o modelo cliente.env.example: nada foi alterado"

  local novas="" linhas=""
  while IFS= read -r linha; do
    [[ $linha =~ ^([A-Z][A-Z0-9_]*)= ]] || continue
    chave=${BASH_REMATCH[1]}
    grep -q "^$chave=" "$env" && continue
    # O hash do link do dono só existe junto com o link: se faltar, a primeira conta já foi criada.
    [[ $chave == OWNER_CLAIM_SHA256 ]] && continue
    valor=$linha
    novas+=" $chave"
    linhas+=$valor$'\n'
  done <<<"$modelo"

  diz "Cliente $CODIGO ($SLUG)"
  if [[ -n $novas ]]; then
    diz "  o .env ganha:$novas"
  else
    diz "  o .env já tem todas as variáveis do modelo"
  fi
  if ((DRY)); then
    simula "reinstalar $PASTA/compose.yml a partir de compose.cliente.yml"
    return 0
  fi

  if [[ -n $linhas ]]; then
    [[ -z $(tail -c1 "$env") ]] || printf '\n' >>"$env"
    {
      printf '\n# acrescentado por doug-cliente compose em %s\n' "$(date -u +%Y-%m-%d)"
      printf '%s' "$linhas"
    } >>"$env"
  fi
  install -m 644 "$SWAS_DIR/compose.cliente.yml" "$PASTA/compose.yml"
  ajusta_permissoes "$PASTA"
  diz "O compose.yml foi reinstalado. Para o cliente usar: doug-cliente iniciar $CODIGO"
}

# ─── lista ───────────────────────────────────────────────────────────────────

estado_de() { # <codigo> <pasta>
  local n
  [[ -f $2/compose.yml ]] || {
    printf 'sem pasta'
    return
  }
  tem_docker || {
    printf '?'
    return
  }
  n=$(compose "$1" "$2" ps --status running -q 2>/dev/null | wc -l | tr -d ' ') || n=?
  case $n in
    0) printf 'parado' ;;
    '?') printf '?' ;;
    1) printf 'parcial' ;;
    *) printf 'no ar' ;;
  esac
}

cmd_lista() {
  ((${#POSICIONAIS[@]} == 0)) || erro "uso: doug-cliente lista"
  if [[ ! -s $REGISTRO ]]; then
    diz "Nenhum cliente em $REGISTRO."
    return 0
  fi
  printf '%-6s %-24s %-30s %-6s %-9s %s\n' CÓDIGO SLUG NOME PORTA ESTADO IMAGEM
  local codigo slug nome porta imagem criado
  while IFS=$'\t' read -r codigo slug nome porta imagem criado || [[ -n ${codigo:-} ]]; do
    [[ -z ${codigo:-} || $codigo == \#* ]] && continue
    printf '%-6s %-24s %-30s %-6s %-9s %s\n' "$codigo" "$slug" "${nome:0:30}" "$porta" "$(estado_de "$codigo" "$RAIZ/$codigo-$slug")" "$imagem"
  done <"$REGISTRO"
}

# ─── parar, iniciar ──────────────────────────────────────────────────────────

pasta_pronta() {
  [[ -f $PASTA/compose.yml && -f $PASTA/.env ]] || erro "faltam o compose.yml ou o .env em $PASTA"
}

cmd_parar() {
  ((${#POSICIONAIS[@]} == 1)) || erro "uso: doug-cliente parar <codigo>"
  exige_docker
  ((DRY)) || trava
  carrega_cliente "${POSICIONAIS[0]}"
  pasta_pronta
  if ((DRY)); then
    simula "docker compose -p doug-$CODIGO stop ($SLUG)"
    return 0
  fi
  passo "parando $CODIGO ($SLUG)"
  compose "$CODIGO" "$PASTA" stop
  diz "Parado. Os dados continuam em $PASTA/dados; para voltar: doug-cliente iniciar $CODIGO"
}

cmd_iniciar() {
  ((${#POSICIONAIS[@]} == 1)) || erro "uso: doug-cliente iniciar <codigo>"
  exige_docker
  ((DRY)) || trava
  carrega_cliente "${POSICIONAIS[0]}"
  pasta_pronta
  if ((DRY)); then
    simula "docker compose -p doug-$CODIGO up -d ($SLUG) e esperar http://127.0.0.1:$PORTA/api/health"
    return 0
  fi
  exige_comando curl
  passo "iniciando $CODIGO ($SLUG)"
  compose "$CODIGO" "$PASTA" up -d
  esperar_saude "$PORTA" || erro "o cliente não respondeu em ${SAUDE_S}s. Veja: docker compose -p doug-$CODIGO logs"
