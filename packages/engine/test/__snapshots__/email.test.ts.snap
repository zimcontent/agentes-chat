exports[`every email, in both languages company_request_resend.pt-BR: snapshot 1`] = `
"<!doctype html>
<html lang="pt-BR" dir="ltr" xmlns="http://www.w3.org/1999/xhtml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="x-apple-disable-message-reformatting">
<meta name="format-detection" content="telephone=no,date=no,address=no,email=no,url=no">
<meta name="color-scheme" content="light only">
<meta name="supported-color-schemes" content="light dark">
<style>
:root{color-scheme:light dark;supported-color-schemes:light dark}
</style>
<style>
@media (prefers-color-scheme:dark){.bg{background:#0a0a0a!important}.card{background:#121212!important;border-color:#262626!important}.ink{color:#ededed!important}.tx{color:#ededed!important}.mu{color:#999999!important}.fa{color:#8a8a8a!important}.well{background:#1a1a1a!important}.wh{border-color:#262626!important}.num{background:#121212!important;border-color:#262626!important;color:#999999!important}.btn{background:#9cfa05!important;color:#0a0a0a!important;border-color:#9cfa05!important}.btn span{color:#0a0a0a!important}.ln{color:#ededed!important;text-decoration-color:#262626!important}.avp{background:#1a1a1a!important;color:#ededed!important;border-color:#262626!important}.warn{background:#2e2410!important}.warn-t{color:#f5b544!important}.ln-d{color:#f2555a!important;text-decoration-color:#262626!important}.ln-m{color:#999999!important;text-decoration-color:#262626!important}.end-btn{margin-bottom:4px!important}.logo-ink{display:none!important}.logo-bone{display:block!important}}
</style>
<style>
[data-ogsc] .bg{background:#0a0a0a!important}[data-ogsb] .bg{background:#0a0a0a!important}
[data-ogsc] .card{background:#121212!important;border-color:#262626!important}[data-ogsb] .card{background:#121212!important;border-color:#262626!important}
[data-ogsc] .ink{color:#ededed!important}[data-ogsb] .ink{color:#ededed!important}
[data-ogsc] .tx{color:#ededed!important}[data-ogsb] .tx{color:#ededed!important}
[data-ogsc] .mu{color:#999999!important}[data-ogsb] .mu{color:#999999!important}
[data-ogsc] .fa{color:#8a8a8a!important}[data-ogsb] .fa{color:#8a8a8a!important}
[data-ogsc] .well{background:#1a1a1a!important}[data-ogsb] .well{background:#1a1a1a!important}
[data-ogsc] .wh{border-color:#262626!important}[data-ogsb] .wh{border-color:#262626!important}
[data-ogsc] .num{background:#121212!important;border-color:#262626!important;color:#999999!important}[data-ogsb] .num{background:#121212!important;border-color:#262626!important;color:#999999!important}
[data-ogsc] .btn{background:#9cfa05!important;color:#0a0a0a!important;border-color:#9cfa05!important}[data-ogsb] .btn{background:#9cfa05!important;color:#0a0a0a!important;border-color:#9cfa05!important}
[data-ogsc] .btn span{color:#0a0a0a!important}[data-ogsb] .btn span{color:#0a0a0a!important}
[data-ogsc] .ln{color:#ededed!important;text-decoration-color:#262626!important}[data-ogsb] .ln{color:#ededed!important;text-decoration-color:#262626!important}
[data-ogsc] .avp{background:#1a1a1a!important;color:#ededed!important;border-color:#262626!important}[data-ogsb] .avp{background:#1a1a1a!important;color:#ededed!important;border-color:#262626!important}
[data-ogsc] .warn{background:#2e2410!important}[data-ogsb] .warn{background:#2e2410!important}
[data-ogsc] .warn-t{color:#f5b544!important}[data-ogsb] .warn-t{color:#f5b544!important}
[data-ogsc] .ln-d{color:#f2555a!important;text-decoration-color:#262626!important}[data-ogsb] .ln-d{color:#f2555a!important;text-decoration-color:#262626!important}
[data-ogsc] .ln-m{color:#999999!important;text-decoration-color:#262626!important}[data-ogsb] .ln-m{color:#999999!important;text-decoration-color:#262626!important}
[data-ogsc] .end-btn{margin-bottom:4px!important}[data-ogsb] .end-btn{margin-bottom:4px!important}
[data-ogsc] .logo-ink{display:none!important}[data-ogsb] .logo-ink{display:none!important}
[data-ogsc] .logo-bone{display:block!important}[data-ogsb] .logo-bone{display:block!important}
</style>
<style>
@media (prefers-color-scheme:light){.btn{background-image:linear-gradient(180deg,#c5ff52 0%,#9cfa05 55%,#84e407 100%)!important}}
</style>
<style>
